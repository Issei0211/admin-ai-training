<p class="notice"><%= notice %></p>

<h1><%= @notice.title %></h1>

<p>
  <%= simple_format(@notice.body) %>
</p>

<p>
  <%= link_to "Edit", edit_notice_path(@notice) %> |
  <%= link_to "Back to notices", notices_path %>
</p>

<%= button_to "Destroy", @notice, method: :delete, form: { data: { turbo_confirm: "Are you sure?" } } %>
